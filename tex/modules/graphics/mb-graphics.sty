\NeedsTeXFormat{LaTeX2e}[2023/06/01]
\ProvidesPackage{mb-graphics}[2026/10/08 v1.1 MatinBook Graphics System]

%========================================================================
% MB-GRAPHICS — GRAPHICS & DRAWINGS
%========================================================================
%
% Purpose:
%   Provide TikZ and PGFPlots configuration for MatinBook.
%
% Loading:
%   This module must be loaded AFTER mb-theme-colors (for colors)
%   and BEFORE xepersian (so tikz/pgfplots load in LTR context).
%
% Known limitation:
%   Due to a LaTeX kernel change (Tagging97, 2024-07-10),
%   lstlisting/minted cannot be placed inside TikZ nodes.
%   Workaround: wrap in \hbox{...} or avoid.
%
%========================================================================


%------------------------------------------------------------------------
% Graphics Packages
%------------------------------------------------------------------------
% NOTE: pgfplots loads tikz automatically, so explicit \RequirePackage{tikz}
%       is not strictly necessary. We include it for clarity.
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% PGF Pie — for pie charts
\RequirePackage{pgf-pie}


%------------------------------------------------------------------------
% TikZ Libraries
%------------------------------------------------------------------------
\usetikzlibrary{
    shapes,
    arrows,
    positioning,
    calc,
    patterns,
    decorations.pathreplacing,
    decorations.pathmorphing,
    decorations.markings,
    backgrounds,
    fit,
    matrix,
    mindmap,
    trees,
    shadows,
    arrows.meta,
    quotes,
    graphs,
    graphs.standard
}


%------------------------------------------------------------------------
% PGFPlots Global Settings
%------------------------------------------------------------------------
\pgfplotsset{
    every axis/.style={
        grid=major,
        grid style={dashed, gray!30},
        axis lines=center,
        axis line style={-stealth, thick},
        xlabel style={anchor=west},
        ylabel style={anchor=south},
        legend style={
            draw=none,
            fill=matinlightgray!30,
            rounded corners=3pt
        },
        title style={
            font=\bfseries
        },
        label style={
            font=\small
        },
        tick label style={
            font=\footnotesize
        }
    },
    ybar/.style={
        bar width=15pt,
        ymajorgrids=true,
        nodes near coords,
        nodes near coords align={vertical}
    }
}


%------------------------------------------------------------------------
% Custom TikZ Styles
%------------------------------------------------------------------------

% Flowchart blocks
\tikzset{
    block/.style={
        rectangle,
        draw=matindarkblue,
        fill=matinlightblue!20,
        text width=6em,
        text centered,
        rounded corners,
        minimum height=3em,
        font=\small
    },
    decision/.style={
        diamond,
        draw=matinorange,
        fill=matinlightorange!20,
        text width=3em,
        text centered,
        inner sep=0pt,
        font=\small
    },
    arrow/.style={
        thick,
        ->,
        >=stealth
    },
    shadowed/.style={
        draw,
        fill=white,
        drop shadow
    },
    treenode/.style={
        circle,
        draw=matinblue,
        fill=matinlightblue!30,
        minimum size=0.8cm,
        font=\small
    }
}


%------------------------------------------------------------------------
% Plot Color Palette
%------------------------------------------------------------------------
\pgfplotscreateplotcyclelist{matinbook}{
    {matinblue, thick},
    {matingreen, thick},
    {matinorange, thick},
    {matinred, thick},
    {matinpurple, thick},
    {matindarkblue, thick},
    {matindarkgreen, thick},
    {matindarkorange, thick}
}

\pgfplotsset{
    cycle list name=matinbook
}


%------------------------------------------------------------------------
% Graphics Path
%------------------------------------------------------------------------
\graphicspath{
    {assets/images/}
    {assets/cover/}
    {images/}
    {figures/}
}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-graphics}{Graphics system loaded (TikZ + PGFPlots + pgf-pie)}

\endinput
