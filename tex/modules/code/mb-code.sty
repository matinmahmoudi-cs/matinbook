%========================================================================
% MB-CODE — CODE LISTING CONFIGURATION (minted)
%========================================================================
%
% Purpose:
%   Configure minted for code listings in Persian technical books.
%
% Compatibility:
%   This configuration targets TeX Live 2023 (Debian) which ships
%   minted v2.6+ and fvextra v1.x.
%
%   - bgcolorpadding is NOT available in fvextra v1.x (only v1.8+).
%     In v1.x, bgcolor already includes internal padding.
%   - python3 option is NOT used (it was a v2 option that is
%     obsolete in v3 and ignored in v2).
%
% Features:
%   - escapeinside=|| for Persian comments (via \pc command)
%   - frame=lines (not single) for clean line breaks
%   - fontsize=\footnotesize (smaller than body text)
%   - style=friendly for syntax highlighting
%
% Persian code:
%   Use \pc{متن فارسی} inside |...| to embed Persian text:
%     |\pc{این یک توضیح است}|
%
%   For Persian comments in Python, use |\pcc{متن فارسی}|.
%   The \pcc macro inserts the leading # and escapes it:
%     |\pcc{این یک توضیح است}|
%
%   NOTE on the double \rl:
%     The \pc macro wraps its argument in \rl twice
%     (\rl{\persiancodingfont\rl{#1}}). A single \rl is not
%     enough inside a minted block because minted wraps the
%     escaped text in its own LTR group, which confuses bidi.
%     The second \rl forces bidi to re-detect the RTL context
%     of the Persian text. This is a known quirk of the
%     xepersian + minted combination.
%
%   NOTE on Python comments:
%     In some Pygments lexers (notably Python), the escape
%     character | is not recognized when it appears
%     immediately after a # comment character. That is why
%     \pcc exists: it puts the # *inside* the escaped region
%     so that Pygments does not see it as a comment start.
%     The # is escaped as \#.
%
%========================================================================


%------------------------------------------------------------------------
% Global Minted Settings
%------------------------------------------------------------------------
\setminted{
    fontsize=\footnotesize,
    linenos=true,
    numbersep=8pt,
    frame=lines,
    framesep=10pt,
    rulecolor=\color{matinbordergray},
    bgcolor=matinlightgray!30,
    breaklines=true,
    breakanywhere=false,
    autogobble=true,
    tabsize=4,
    escapeinside=||,
    baselinestretch=0.95,
    style=friendly
}


%------------------------------------------------------------------------
% Persian Code Font (defined AFTER xepersian is loaded)
%------------------------------------------------------------------------
% DejaVu Sans Mono is available on all Linux systems and supports
% Persian characters with proper Arabic script shaping.
%
% NOTE: \defpersianfont is defined by xepersian. Since mb-code is
% loaded BEFORE xepersian in matinbook.cls, we use \AtBeginDocument
% to defer the definition until xepersian is available.
%
% \pc{...}   — wraps Persian text with the Persian code font and
%              a double \rl group. Use it inside |...| in a
%              minted block.
%
% \pcc{...}  — expands to \pc{\#~...}. Use it inside |...| in a
%              minted block for Python (and similar languages)
%              where | after # is not recognized. The # is
%              placed inside the escaped region and escaped
%              as \#.
%
%              Usage in a Python code block:
%
%                x = 5  |\pcc{مقدار متغیر}|
%
%              which renders as:
%
%                x = 5  # مقدار متغیر
%------------------------------------------------------------------------
\AtBeginDocument{%
    \defpersianfont\persiancodingfont{DejaVu Sans Mono}[Script=Arabic,Scale=0.9]%
    \newcommand{\pc}[1]{\rl{\persiancodingfont\rl{#1}}}%
    \newcommand{\pcc}[1]{\pc{\#~#1}}%
}


%------------------------------------------------------------------------
% Inline Code
%------------------------------------------------------------------------
\newcommand{\inlcode}[1]{\lr{\mintinline{text}{#1}}}


%------------------------------------------------------------------------
% Code Listing Counter
%------------------------------------------------------------------------
\newcounter{listingcounter}[chapter]
\renewcommand{\thelistingcounter}{\thechapter.\arabic{listingcounter}}

\newcommand{\codecaption}[1]{%
    \refstepcounter{listingcounter}%
    \par\vspace{5pt}%
    \noindent\textbf{\codename\space\thelistingcounter:} #1%
    \par\vspace{5pt}%
}

\newcommand{\coderef}[1]{\codename\space\ref{#1}}


%------------------------------------------------------------------------
% Cleveref
%------------------------------------------------------------------------
\crefname{listingcounter}{\codename}{\codename}
\Crefname{listingcounter}{\codename}{\codename}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-code}{Code system loaded (minted v2, Persian support, \string\pc, \string\pcc)}

\endinput