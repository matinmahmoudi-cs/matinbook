%========================================================================
% MB-THEOREM — THEOREM ENVIRONMENTS
%========================================================================
%
% Purpose:
%   Define theorem-like environments with two visual styles.
%
% Design families (from mb-boxes):
%   1. matinbox      — Boyer-style (solid title bar, white body)
%   2. matin-outline — Outline style (right line + horizontal rules, RTL)
%
% Environment assignments:
%   Family 1 (matinbox):
%     theorem, lemma, corollary, proposition,
%     definition, remark, exercise
%
%   Family 2 (matin-outline):
%     example, proof, solution
%
% Architecture:
%   - All numbered environments share counter: matin@thmcounter
%   - Counter resets per chapter
%   - Optional title: \begin{theorem}[نام] → "قضیه ۱.۱: نام"
%
% Reference helpers:
%   \thmref, \lemref, \corref, \propref, \defref,
%   \exref, \remref, \excref
%
%========================================================================


%------------------------------------------------------------------------
% Shared Counter
%------------------------------------------------------------------------
\newcounter{matin@thmcounter}[chapter]
\renewcommand{\thematin@thmcounter}{\thechapter.\arabic{matin@thmcounter}}


%------------------------------------------------------------------------
% Title Builder
%------------------------------------------------------------------------
\newcommand{\matin@thmtitle}[2]{%
    #1~\thetcbcounter
    \ifx\relax#2\relax\else:~#2\fi
}


%------------------------------------------------------------------------
% Helper: Create Themed Environment
%------------------------------------------------------------------------
% #1 = environment name (e.g., theorem)
% #2 = display name     (e.g., قضیه)
% #3 = tcolorbox style  (e.g., matin-theorem)
% #4 = body font style  (itshape, normalfont, \bfseries\color{black}, ...)
%------------------------------------------------------------------------
\newcommand{\matin@newthm}[4]{%
    \newtcolorbox[use counter=matin@thmcounter]{#1}[1][]{%
        #3,
        title={\matin@thmtitle{#2}{##1}},
        fontupper={#4}%
    }%
}


%------------------------------------------------------------------------
% Theorem Family (Family 1 — matinbox, blue, italic body)
%------------------------------------------------------------------------
\matin@newthm{theorem}    {قضیه}  {matin-theorem}    {\itshape}
\matin@newthm{lemma}      {لم}    {matin-lemma}      {\itshape}
\matin@newthm{corollary}  {نتیجه} {matin-corollary}  {\itshape}
\matin@newthm{proposition}{گزاره} {matin-proposition}{\itshape}


%------------------------------------------------------------------------
% Definition Family (Family 1 — matinbox, normal body)
%------------------------------------------------------------------------
\matin@newthm{definition}{تعریف}{matin-definition}{\normalfont}
\matin@newthm{remark}    {نکته} {matin-remark}    {\normalfont}
\matin@newthm{exercise}  {تمرین}{matin-exercise}  {\normalfont}


%------------------------------------------------------------------------
% Example (Family 2 — outline, numbered, orange, black bold body)
%------------------------------------------------------------------------
\matin@newthm{example}   {مثال} {matin-example-outline} {\bfseries\color{black}}


%------------------------------------------------------------------------
% Solution (Family 2 — outline, no counter, green, black bold body)
%------------------------------------------------------------------------
\newtcolorbox{solution}{
    matin-solution-outline,
    title={\textbf{\solutionname}},
    fontupper=\bfseries\color{black}
}


%------------------------------------------------------------------------
% Proof (Family 2 — outline, no counter, gray, black bold body, \qed)
%------------------------------------------------------------------------
% amsthm (loaded in mb-core) defines \proof. We clear it first
% to avoid "Command \proof already defined" error.
%------------------------------------------------------------------------
\let\proof\relax
\let\endproof\relax

\newtcolorbox{proof}[1][]{
    matin-proof-outline,
    title={\textbf{\proofname}\ifx\relax#1\relax\else:~#1\fi},
    fontupper=\bfseries\color{black},
    after upper={\hfill$\qedsymbol$}
}


%------------------------------------------------------------------------
% Reference Helpers
%------------------------------------------------------------------------
\newcommand{\thmref}[1]{\cref{#1}}
\newcommand{\lemref}[1]{\cref{#1}}
\newcommand{\corref}[1]{\cref{#1}}
\newcommand{\propref}[1]{\cref{#1}}
\newcommand{\defref}[1]{\cref{#1}}
\newcommand{\exref}[1]{\cref{#1}}
\newcommand{\remref}[1]{\cref{#1}}
\newcommand{\excref}[1]{\cref{#1}}


%------------------------------------------------------------------------
% Cleveref Names
%------------------------------------------------------------------------
\crefalias{theorem}    {matin@thmcounter}
\crefalias{lemma}      {matin@thmcounter}
\crefalias{corollary}  {matin@thmcounter}
\crefalias{proposition}{matin@thmcounter}
\crefalias{definition} {matin@thmcounter}
\crefalias{example}    {matin@thmcounter}
\crefalias{remark}     {matin@thmcounter}
\crefalias{exercise}   {matin@thmcounter}

\crefname{theorem}    {قضیه} {قضایا}
\crefname{lemma}      {لم}   {لم‌ها}
\crefname{corollary}  {نتیجه}{نتایج}
\crefname{proposition}{گزاره}{گزاره‌ها}
\crefname{definition} {تعریف}{تعاریف}
\crefname{example}    {مثال} {مثال‌ها}
\crefname{remark}     {نکته} {نکات}
\crefname{exercise}   {تمرین}{تمرین‌ها}

\Crefname{theorem}    {قضیه} {قضایا}
\Crefname{lemma}      {لم}   {لم‌ها}
\Crefname{corollary}  {نتیجه}{نتایج}
\Crefname{proposition}{گزاره}{گزاره‌ها}
\Crefname{definition} {تعریف}{تعاریف}
\Crefname{example}    {مثال} {مثال‌ها}
\Crefname{remark}     {نکته} {نکات}
\Crefname{exercise}   {تمرین}{تمرین‌ها}


