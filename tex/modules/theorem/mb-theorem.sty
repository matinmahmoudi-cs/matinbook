%========================================================================
% MB-THEOREM — THEOREM ENVIRONMENTS (via amsthm)
%========================================================================
%
% Purpose:
%   Define theorem-like environments using amsthm's \newtheorem,
%   then style them with tcolorbox via \tcolorboxenvironment.
%
% Architecture:
%   - amsthm (loaded in mb-core) handles:
%       * Counters and shared numbering
%       * \label / \ref support
%       * \qed symbol for proofs
%   - mb-boxes provides tcolorbox styles
%   - This module combines them
%
% Shared counter:
%   theorem, lemma, corollary, proposition share a single counter.
%   definition, example, remark, exercise each have independent counters.
%
%========================================================================


%------------------------------------------------------------------------
% Theorem Family (shared counter with definition)
%------------------------------------------------------------------------
\theoremstyle{definition}
\newtheorem{definition}{تعریف}[chapter]

\theoremstyle{plain}
\newtheorem{theorem}[definition]{قضیه}
\newtheorem{lemma}[definition]{لم}
\newtheorem{corollary}[definition]{نتیجه}
\newtheorem{proposition}[definition]{گزاره}

\theoremstyle{definition}
\newtheorem{example}[definition]{مثال}

\theoremstyle{remark}
\newtheorem{remark}[definition]{نکته}
\newtheorem{exercise}[definition]{تمرین}


%------------------------------------------------------------------------
% tcolorbox Styles (from mb-boxes)
%------------------------------------------------------------------------
\tcolorboxenvironment{theorem}{matin-theorem}
\tcolorboxenvironment{lemma}{matin-lemma}
\tcolorboxenvironment{corollary}{matin-corollary}
\tcolorboxenvironment{proposition}{matin-proposition}
\tcolorboxenvironment{definition}{matin-definition}
\tcolorboxenvironment{example}{matin-example}
\tcolorboxenvironment{remark}{matin-remark}
\tcolorboxenvironment{exercise}{matin-exercise}


%------------------------------------------------------------------------
% Solution Environment (no numbering)
%------------------------------------------------------------------------
\newenvironment{solution}{%
    \begin{tcolorbox}[matin-solution, title={\textbf{\solutionname}}]%
}{%
    \end{tcolorbox}%
}


%------------------------------------------------------------------------
% Proof Environment (preserves \qed)
%------------------------------------------------------------------------
\renewenvironment{proof}[1][]{%
    \begin{tcolorbox}[matin-proof, title={\textbf{\proofname}}]%
    \ifx\relax#1\relax\else\textbf{#1}\par\fi
}{%
    \hfill$\qedsymbol$%
    \end{tcolorbox}%
}


%------------------------------------------------------------------------
% Cleveref Names (using environment names, not counter names)
%------------------------------------------------------------------------
\crefname{theorem}{قضیه}{قضایا}
\Crefname{theorem}{قضیه}{قضایا}

\crefname{lemma}{لم}{لم‌ها}
\Crefname{lemma}{لم}{لم‌ها}

\crefname{corollary}{نتیجه}{نتایج}
\Crefname{corollary}{نتیجه}{نتایج}

\crefname{proposition}{گزاره}{گزاره‌ها}
\Crefname{proposition}{گزاره}{گزاره‌ها}

\crefname{definition}{تعریف}{تعاریف}
\Crefname{definition}{تعریف}{تعاریف}

\crefname{example}{مثال}{مثال‌ها}
\Crefname{example}{مثال}{مثال‌ها}

\crefname{remark}{نکته}{نکات}
\Crefname{remark}{نکته}{نکات}

\crefname{exercise}{تمرین}{تمرین‌ها}
\Crefname{exercise}{تمرین}{تمرین‌ها}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-theorem}{Theorem environments loaded (via amsthm)}

\endinput
