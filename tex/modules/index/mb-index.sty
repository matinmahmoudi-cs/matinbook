%========================================================================
% MB-INDEX — INDEX SYSTEM (xindy + Persian)
%========================================================================
%
% Purpose:
%   Configure index generation for Persian technical books.
%
% Critical:
%   makeindex CANNOT sort Persian correctly. It fails to order
%   the Persian-specific letters پ, چ, ژ, گ, ک correctly.
%   We MUST use xindy with the persian-variant2 language module.
%
% Requirements:
%   - xindy and texindy must be installed
%   - xindy-persian (variant2) must be available
%   - Compilation requires -shell-escape
%
% Compilation:
%   xelatex -shell-escape document.tex
%   (xindy is called automatically by imakeidx via shell-escape)
%
%========================================================================


%------------------------------------------------------------------------
% Index Setup (xindy + Persian variant2)
%------------------------------------------------------------------------
\makeindex[
    intoc,
    program=xindy,
    options={-L persian-variant2 -C utf8 -M texindy -M page-ranges}
]


%------------------------------------------------------------------------
% Index Formatting (xepersian customization)
%------------------------------------------------------------------------
% xepersian provides these commands for customizing index appearance.
% Uncomment and adjust to change the look.
%
% \indexFormat{...}         % format of the index title
% \indexEntryFormat{...}    % format of each index entry
% \indexEntryPageTxt{...}   % text that goes before page numbers
% \indexEntryPageFormat{...}% format of page numbers
% \indexEntrySeparator{...} % separator between entries


%------------------------------------------------------------------------
% Index Entry Helpers
%------------------------------------------------------------------------

% Bold index entry
\newcommand{\idxbold}[1]{\index{#1|textbf}}

% Italic index entry
\newcommand{\idxitalic}[1]{\index{#1|textit}}

% See reference (xindy-compatible)
\newcommand{\idxsee}[2]{\index{#1|see{#2}}}

% See also reference (xindy-compatible)
\newcommand{\idxseealso}[2]{\index{#1|seealso{#2}}}

% Primary entry with subentry
\newcommand{\idxsub}[2]{\index{#1!#2}}

% Primary entry with sub-subentry
\newcommand{\idxsubsub}[3]{\index{#1!#2!#3}}


%------------------------------------------------------------------------
% Process Index
%------------------------------------------------------------------------
\newcommand{\printallindexes}{%
    \printindex
}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-index}{Index system loaded (xindy + persian-variant2)}

\endinput
