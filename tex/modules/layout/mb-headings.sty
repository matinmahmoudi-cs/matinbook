\ProvidesPackage{mb-headings}[2026/10/08 v1.1 MatinBook Heading Styles]

%========================================================================
% MB-HEADINGS — CHAPTER/SECTION STYLES
%========================================================================
%
% Purpose:
%   Define chapter, section, subsection styles for MatinBook,
%   following the Boyer/Stewart university textbook scale.
%
% Heading scale (Boyer/Stewart standard):
%   Chapter number:  24pt  (was 36pt)
%   Chapter title:   20pt  (was \LARGE = 17pt)
%   \section:        15pt  (was 17pt)
%   \subsection:     13pt  (was 14pt)
%   \subsubsection:  11pt  (was \normalsize = 10pt)
%
% Design:
%   - Chapter number: 24pt colored digit
%   - Chapter title: 20pt
%   - Section: colored box with number, 15pt
%   - Subsection: colored number, 13pt
%   - Subsubsection: colored number, 11pt
%
% Note:
%   This module uses colors from mb-theme-colors, which MUST be
%   loaded BEFORE this module in matinbook.cls.
%
%========================================================================


%------------------------------------------------------------------------
% Chapter Style (Boyer/Stewart: 24pt number, 20pt title)
%------------------------------------------------------------------------
\titleformat{\chapter}[display]
{\normalfont\bfseries\color{matindarkgray}}
{%
    \color{matinblue!20}\fontsize{24}{28}\selectfont\thechapter
}
{10pt}
{%
    \fontsize{20}{24}\selectfont
}
[\vspace{5pt}\noindent\textcolor{matinblue}{\rule{\textwidth}{1.5pt}}]

\titlespacing*{\chapter}
{0pt}
{20pt}
{30pt}


%------------------------------------------------------------------------
% Section Style (Boyer/Stewart: 15pt)
%------------------------------------------------------------------------
\titleformat{\section}
{\normalfont\fontsize{15}{18}\selectfont\bfseries\color{matindarkgray}}
{%
    \colorbox{matinblue!15}{\color{matinblue}\bfseries\thesection}%
}
{0.8em}
{}

\titlespacing*{\section}
{0pt}
{20pt}
{10pt}


%------------------------------------------------------------------------
% Subsection Style (Boyer/Stewart: 13pt)
%------------------------------------------------------------------------
\titleformat{\subsection}
{\normalfont\fontsize{13}{16}\selectfont\bfseries\color{matindarkgray}}
{\color{matinblue!70}\thesubsection}
{0.8em}
{}

\titlespacing*{\subsection}
{0pt}
{15pt}
{8pt}


%------------------------------------------------------------------------
% Subsubsection Style (Boyer/Stewart: 11pt)
%------------------------------------------------------------------------
\titleformat{\subsubsection}
{\normalfont\fontsize{11}{13}\selectfont\bfseries\color{matindarkgray}}
{\color{matinblue!50}\thesubsubsection}
{0.8em}
{}

\titlespacing*{\subsubsection}
{0pt}
{12pt}
{6pt}


%------------------------------------------------------------------------
% Running Headers
%------------------------------------------------------------------------
% Use \markboth for both marks to ensure consistency in twoside.
% Format: chapter name only (no "Chapter N:" prefix).
%------------------------------------------------------------------------
\renewcommand{\chaptermark}[1]{%
    \markboth{%
        \ifnum\c@chapter>0
            \small\bfseries #1%
        \fi
    }{%
        \ifnum\c@chapter>0
            \small\bfseries #1%
        \fi
    }%
}

\renewcommand{\sectionmark}[1]{%
    \markright{%
        \ifnum\c@chapter>0
            \small\bfseries #1%
        \fi
    }%
}


%------------------------------------------------------------------------
% Table of Contents Style
%------------------------------------------------------------------------
\renewcommand{\cftchapfont}{\bfseries\color{matindarkgray}}
\renewcommand{\cftchappagefont}{\bfseries\color{matinblue}}
\renewcommand{\cftsecfont}{\color{matindarkgray}}
\renewcommand{\cftsubsecfont}{\color{matinmediumgray}}
\renewcommand{\cftsubsubsecfont}{\color{matinmediumgray!70}}

% Dots in ToC (4.5 is the LaTeX default — sparse, readable)
\renewcommand{\cftdotsep}{4.5}
\renewcommand{\cftdot}{%
    \textcolor{matinblue!30}{.}%
}

% Chapter number style in ToC
\renewcommand{\cftchappresnum}{\color{matinblue!70}}
\renewcommand{\cftchapaftersnum}{}

% Space before chapter in ToC
\setlength{\cftbeforechapskip}{8pt}
\setlength{\cftbeforesecskip}{4pt}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-headings}{Heading styles loaded (Boyer/Stewart scale)}

\endinput