\ProvidesPackage{mb-layout}[2026/01/01 v1.1 MatinBook Layout System]

%========================================================================
% MB-LAYOUT — PAGE LAYOUT CONFIGURATION
%========================================================================
%
% Page format:
%   - Paper size: 17.8 × 25.4 cm (7 × 10 in)
%   - Inner margin: 1.5cm (near spine)
%   - Outer margin: 5.9cm (wide — for margin notes)
%   - marginparwidth: 3.5cm
%   - marginparsep: 0.6cm (gap between text and note)
%
% Line spacing:
%   Boyer/Stewart-style textbook leading (1.15).
%
% Margin notes (RTL fix):
%   We use the standard \marginpar (not sidenotesplus) because
%   \marginpar handles twoside odd/even placement at the LaTeX
%   kernel level and cannot be broken by bidi.
%
%   We do NOT use \reversemarginpar because \marginpar already
%   places notes on the correct side under twoside. Adding
%   \reversemarginpar would double-reverse the position.
%
%   \RL{...} (from xepersian) forces the note content into an
%   independent RTL group, so the direction is never inherited
%   from the (LTR) verso page.
%
%   \mnote{...}          — plain margin note (RTL, no number)
%   \marginfig{...}{...} — figure + caption in margin
%
%========================================================================


%------------------------------------------------------------------------
% Page Geometry (wide margin for notes)
%------------------------------------------------------------------------
\geometry{
    paperwidth=17.8cm,
    paperheight=25.4cm,
    top=1.7cm,
    bottom=1.7cm,
    inner=1.5cm,
    outer=5.9cm,
    marginparwidth=3.5cm,
    marginparsep=0.6cm,
    headheight=15pt,
    headsep=5pt,
    footskip=18pt,
    bindingoffset=0.4cm
}


%------------------------------------------------------------------------
% Margin Notes (standard \marginpar, RTL-aware)
%------------------------------------------------------------------------
% NOTE: We do NOT use \reversemarginpar.
%       \marginpar already places notes on the correct side
%       (outer margin) under twoside. Adding \reversemarginpar
%       would double-reverse the position.

% Plain margin note (RTL, no number)
% \RL{} forces the content into an RTL group, so the direction
% cannot be inherited from the (LTR) verso page.
\newcommand{\mnote}[1]{%
    \marginpar{\RL{\footnotesize #1}}%
}

% Margin figure with caption
\newcommand{\marginfig}[2]{%
    \marginpar{%
        \includegraphics[width=\marginparwidth]{#1}%
        \par\vspace{2pt}%
        \RL{\footnotesize #2}%
    }%
}


%------------------------------------------------------------------------
% Header and Footer Setup
%------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}

\fancyhead[LE]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyhead[RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyfoot[LE,RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\thepage}%
    \fi
}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[LE,RO]{%
        \footnotesize\textbf{\thepage}%
    }
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}


%------------------------------------------------------------------------
% Line Spacing (Boyer/Stewart textbook leading)
%------------------------------------------------------------------------
\setstretch{1.15}


%------------------------------------------------------------------------
% Paragraph Settings
%------------------------------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}


%------------------------------------------------------------------------
% Caption Settings
%------------------------------------------------------------------------
\captionsetup{
    font=footnotesize,
    labelfont=bf,
    skip=8pt,
    justification=centering
}


%------------------------------------------------------------------------
% Footnote Settings
%------------------------------------------------------------------------
\setlength{\footnotesep}{8pt}
\renewcommand{\footnoterule}{%
    \kern-3pt
    \hrule width 0.3\textwidth height 0.4pt
    \kern2.6pt
}


%------------------------------------------------------------------------
% Draft Watermark
%------------------------------------------------------------------------
\if@matin@draft
    \AtBeginDocument{%
        \RequirePackage{draftwatermark}%
        \SetWatermarkText{\lr{DRAFT}}%
        \SetWatermarkScale{1.5}%
        \SetWatermarkColor[gray]{0.9}%
    }
\fi


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-layout}{Layout loaded (wide margin, marginpar RTL, stretch 1.15)}

\endinput