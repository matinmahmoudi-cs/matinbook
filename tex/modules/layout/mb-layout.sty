\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mb-layout}[2026/01/01 v1.1 MatinBook Layout System]

%========================================================================
% MB-LAYOUT — PAGE LAYOUT CONFIGURATION
%========================================================================
%
% Standard: O'Reilly Media (Vaziri adaptation)
%   - Page size: 16.5 × 24 cm
%   - Margins: top=2.0cm, bottom=2.5cm, inner/outer=2.0cm
%   - Binding offset: 0.5cm
%
% Header/Footer:
%   - Even pages (left): book title
%   - Odd pages (right): chapter name
%   - Page number: in footer
%
%========================================================================


%------------------------------------------------------------------------
% Page Geometry (Vaziri format, O'Reilly standard)
%------------------------------------------------------------------------
\geometry{
    paperwidth=17.8cm,
    paperheight=25.4cm,
    top=1.7cm,
    bottom=1.7cm,
    inner=1.4cm,
    outer=1.4cm,
    headheight=13pt,
    headsep=5pt,
    footskip=18pt,
    bindingoffset=0.4cm,
    marginparwidth=0pt,
    marginparsep=0pt
}


%------------------------------------------------------------------------
% Header and Footer Setup
%------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}

% Even pages (left in twoside): chapter name
\fancyhead[LE]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

% Odd pages (right in twoside): chapter name
\fancyhead[RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

% Page number in footer (both outer sides)
\fancyfoot[LE,RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\thepage}%
    \fi
}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Plain page style (for chapter opening pages)
\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[LE,RO]{%
        \footnotesize\textbf{\thepage}%
    }
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}


%------------------------------------------------------------------------
% Line Spacing
%------------------------------------------------------------------------
\setstretch{1.03}


%------------------------------------------------------------------------
% Paragraph Settings
%------------------------------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}


%------------------------------------------------------------------------
% Caption Settings
%------------------------------------------------------------------------
\captionsetup{
    font=footnotesize,
    labelfont=bf,
    skip=8pt,
    justification=centering
}


%------------------------------------------------------------------------
% Footnote Settings
%------------------------------------------------------------------------
\setlength{\footnotesep}{8pt}
\renewcommand{\footnoterule}{%
    \kern-3pt
    \hrule width 0.3\textwidth height 0.4pt
    \kern2.6pt
}


%------------------------------------------------------------------------
% Draft Watermark
%------------------------------------------------------------------------
\if@matin@draft
    \RequirePackage{draftwatermark}
    \SetWatermarkText{\lr{DRAFT}}
    \SetWatermarkScale{1.5}
    \SetWatermarkColor[gray]{0.9}
\fi


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-layout}{Layout loaded (Vaziri format, O'Reilly standard)}

\endinput
