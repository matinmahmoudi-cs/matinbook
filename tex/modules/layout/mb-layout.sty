\ProvidesPackage{mb-layout}[2026/01/01 v1.1 MatinBook Layout System]

%========================================================================
% MB-LAYOUT — PAGE LAYOUT CONFIGURATION
%========================================================================
%
% Page format:
%   - Paper size: 17.8 × 25.4 cm (7 × 10 in)
%   - Inner margin: 1.5cm (near spine)
%   - Outer margin: 5.6cm (wide — for margin notes)
%   - marginparwidth: 3.5cm
%   - marginparsep: 0.3cm
%
% Line spacing:
%   Boyer/Stewart-style textbook leading (1.15) — loose and
%   formula-friendly, unlike the more compact O'Reilly style.
%
% Margin notes:
%   Uses sidenotesplus, which correctly handles:
%     - twoside (odd/even pages)
%     - RTL (bidi/xepersian)
%     - tcolorbox and float environments
%
%   \mnote{...}         — plain margin note
%   \marginfig{...}{...} — figure + caption in margin
%
% Usage:
%   \mnote{یادداشت حاشیه}
%   \marginfig{file}{caption}
%
%========================================================================


%------------------------------------------------------------------------
% Page Geometry (wide margin for notes)
%------------------------------------------------------------------------
\geometry{
    paperwidth=17.8cm,
    paperheight=25.4cm,
    top=1.7cm,
    bottom=1.7cm,
    inner=1.5cm,
    outer=5.6cm,
    marginparwidth=3.5cm,
    marginparsep=0.3cm,
    headheight=15pt,
    headsep=5pt,
    footskip=18pt,
    bindingoffset=0.4cm
}


%------------------------------------------------------------------------
% Margin Notes (sidenotesplus, RTL-aware)
%------------------------------------------------------------------------
\RequirePackage{sidenotesplus}

% NOTE: We do NOT use \reversemarginpar here.
%       sidenotesplus already handles RTL correctly under bidi/xepersian.
%       Adding \reversemarginpar would double-reverse the direction.

% Simple aliases for user convenience
\newcommand{\mnote}[1]{\sidenote{#1}}

\newcommand{\marginfig}[2]{%
    \begin{marginfigure}%
        \includegraphics[width=\marginparwidth]{#1}%
        \caption{#2}%
    \end{marginfigure}%
}


%------------------------------------------------------------------------
% Header and Footer Setup
%------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}

\fancyhead[LE]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyhead[RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyfoot[LE,RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\thepage}%
    \fi
}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[LE,RO]{%
        \footnotesize\textbf{\thepage}%
    }
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}


%------------------------------------------------------------------------
% Line Spacing (Boyer/Stewart textbook leading)
%------------------------------------------------------------------------
\setstretch{1.15}


%------------------------------------------------------------------------
% Paragraph Settings
%------------------------------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}


%------------------------------------------------------------------------
% Caption Settings
%------------------------------------------------------------------------
\captionsetup{
    font=footnotesize,
    labelfont=bf,
    skip=8pt,
    justification=centering
}


%------------------------------------------------------------------------
% Footnote Settings
%------------------------------------------------------------------------
\setlength{\footnotesep}{8pt}
\renewcommand{\footnoterule}{%
    \kern-3pt
    \hrule width 0.3\textwidth height 0.4pt
    \kern2.6pt
}


%------------------------------------------------------------------------
% Draft Watermark
%------------------------------------------------------------------------
\if@matin@draft
    \AtBeginDocument{%
        \RequirePackage{draftwatermark}%
        \SetWatermarkText{\lr{DRAFT}}%
        \SetWatermarkScale{1.5}%
        \SetWatermarkColor[gray]{0.9}%
    }
\fi


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-layout}{Layout loaded (wide margin, sidenotesplus, stretch 1.15)}

\endinput