\ProvidesPackage{mb-layout}[2026/10/08 v1.1 MatinBook Layout System]

%========================================================================
% MB-LAYOUT — PAGE LAYOUT CONFIGURATION
%========================================================================
%
% Two page geometries:
%   - Frontmatter (no wide margin): margins are symmetric, text width
%     is wider. Used for: copyright, dedication, preface, ToC, LoF, LoT.
%   - Mainmatter (wide margin): outer margin is wide (5.9cm) to make
%     room for margin notes. Used for the actual chapters.
%
% Usage in main.tex:
%   \frontmatter
%   \frontmattergeometry   % switch to symmetric margins
%   \maketitle
%   \tableofcontents
%   ...
%   \mainmatter
%   \mainmattergeometry    % restore wide-margin geometry
%   \chapter{...}
%
%========================================================================


%------------------------------------------------------------------------
% Page Geometry (mainmatter — wide margin for notes)
%------------------------------------------------------------------------
\geometry{
    paperwidth=17.8cm,
    paperheight=25.4cm,
    top=1.7cm,
    bottom=1.7cm,
    inner=1.5cm,
    outer=5.9cm,
    marginparwidth=3.5cm,
    marginparsep=0.6cm,
    headheight=15pt,
    headsep=5pt,
    footskip=18pt,
    bindingoffset=0.4cm
}


%------------------------------------------------------------------------
% Frontmatter Geometry (no wide margin)
%------------------------------------------------------------------------
% Symmetric margins, no margin notes area.
%------------------------------------------------------------------------
\newcommand{\frontmattergeometry}{%
    \newgeometry{
        paperwidth=17.8cm,
        paperheight=25.4cm,
        top=1.7cm,
        bottom=1.7cm,
        inner=1.5cm,
        outer=1.5cm,
        marginparwidth=0pt,
        marginparsep=0pt,
        headheight=15pt,
        headsep=5pt,
        footskip=18pt,
        bindingoffset=0.4cm
    }%
}


%------------------------------------------------------------------------
% Mainmatter Geometry (restore wide margin)
%------------------------------------------------------------------------
\newcommand{\mainmattergeometry}{%
    \restoregeometry
}


%------------------------------------------------------------------------
% Margin Notes (standard \marginpar, RTL-aware)
%------------------------------------------------------------------------
\newcommand{\mnote}[1]{%
    \marginpar{\RL{\footnotesize #1}}%
}

\newcommand{\marginfig}[2]{%
    \marginpar{%
        \includegraphics[width=\marginparwidth]{#1}%
        \par\vspace{2pt}%
        \RL{\footnotesize #2}%
    }%
}


%------------------------------------------------------------------------
% Header and Footer Setup
%------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}

\fancyhead[LE]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyhead[RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\leftmark}%
    \fi
}

\fancyfoot[LE,RO]{%
    \ifnum\c@chapter>0
        \footnotesize\textbf{\thepage}%
    \fi
}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[LE,RO]{%
        \footnotesize\textbf{\thepage}%
    }
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}


%------------------------------------------------------------------------
% Line Spacing (Boyer/Stewart textbook leading)
%------------------------------------------------------------------------
\setstretch{1.15}


%------------------------------------------------------------------------
% Paragraph Settings
%------------------------------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}


%------------------------------------------------------------------------
% Caption Settings
%------------------------------------------------------------------------
\captionsetup{
    font=footnotesize,
    labelfont=bf,
    skip=8pt,
    justification=centering
}


%------------------------------------------------------------------------
% Footnote Settings
%------------------------------------------------------------------------
\setlength{\footnotesep}{8pt}
\renewcommand{\footnoterule}{%
    \kern-3pt
    \hrule width 0.3\textwidth height 0.4pt
    \kern2.6pt
}


%------------------------------------------------------------------------
% Draft Watermark
%------------------------------------------------------------------------
\if@matin@draft
    \AtBeginDocument{%
        \RequirePackage{draftwatermark}%
        \SetWatermarkText{\lr{DRAFT}}%
        \SetWatermarkScale{1.5}%
        \SetWatermarkColor[gray]{0.9}%
    }
\fi


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-layout}{Layout loaded (frontmatter/mainmatter geometries, stretch 1.15)}

\endinput