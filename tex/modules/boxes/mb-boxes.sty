%========================================================================
% MB-BOXES — TCOLORBOX STYLES
%========================================================================
%
% Purpose:
%   Provide tcolorbox STYLES for theorem-like environments.
%
% Two design families:
%   1. "matinbox"      — Boyer-style: solid colored title bar, white body
%   2. "matin-outline" — Outline style: right vertical line + two
%                        horizontal rules (under title and under content)
%
% Design family 1 (matinbox) — used by:
%   theorem, lemma, corollary, proposition, definition, remark, exercise
%
% Design family 2 (matin-outline) — used by:
%   example, proof, solution
%
% Title font size:
%   \normalsize (10pt) — same as body text, per AMS/Boyer standard.
%
% RTL note:
%   In matin-outline, the vertical line is drawn on the RIGHT side
%   (east side in LTR coordinates, which is the visual right side
%   in RTL typesetting). Unlike an earlier design, the line is NOT
%   mirrored on even pages: it is always on the right, to keep the
%   visual identity of the box consistent across the whole book.
%
% Color note:
%   In matin-outline, the title text is BLACK (coltitle=black),
%   while the three decorative rules keep the style color (#1).
%
% Line width note:
%   Per project decision, ALL three rules (top horizontal, bottom
%   horizontal, and vertical) are drawn at 2pt.
%
% Visual specification (RTL):
%
%       ──────────────────────────────────┤ EXAMPLE 1
%                                         │
%                                         │  content...
%                                         │
%       ──────────────────────────────────
%
%   That is:
%     - A 2pt horizontal rule immediately under the title
%       (i.e., under "EXAMPLE 1", "PROOF", "SOLUTION", ...).
%     - A 2pt horizontal rule immediately under the content
%       (at the bottom of the box).
%     - A 2pt vertical rule on the RIGHT side, spanning the
%       full height of the box, present on every fragment if
%       the box is broken across pages.
%
% Breakable handling:
%   Three underlay hooks are used, one per breakage state:
%
%     - `underlay unbroken`: draws BOTH horizontal rules.
%       Applies only when the box fits on a single page.
%
%     - `underlay first`: draws ONLY the top rule.
%       Applies to the first fragment of a broken box.
%
%     - `underlay last`: draws ONLY the bottom rule.
%       Applies to the last fragment of a broken box.
%
%   The vertical rule is drawn with `borderline east`, which
%   survives all breakage states and is not affected by
%   `frame hidden`.
%
%   Earlier revisions used a per-page parity switch to mirror
%   the vertical rule on even pages. That design was removed:
%   the visual identity of the box is more important than
%   alignment with the outer margin, and the parity logic
%   was fragile across tcolorbox versions.
%
%========================================================================


%========================================================================
% FAMILY 1 — BOYER-STYLE BOXES (matinbox)
%========================================================================

%------------------------------------------------------------------------
% Base Style
%------------------------------------------------------------------------
\tcbset{
    matinbox/.style={
        enhanced,
        breakable,
        sharp corners,
        boxrule=0.5pt,
        colback=white,
        colframe=#1,
        colbacktitle=#1,
        coltitle=white,
        fonttitle=\bfseries\normalsize,
        titlerule=0pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        toptitle=5pt,
        bottomtitle=5pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false
    }
}


%------------------------------------------------------------------------
% Theorem Family Styles (blue)
%------------------------------------------------------------------------
\tcbset{
    matin-theorem/.style={matinbox=matinblue},
    matin-lemma/.style={matinbox=matinblue!85!black},
    matin-corollary/.style={matinbox=matinblue!70!black},
    matin-proposition/.style={matinbox=matinblue!90!black}
}


%------------------------------------------------------------------------
% Definition Family Style (green)
%------------------------------------------------------------------------
\tcbset{
    matin-definition/.style={matinbox=matingreen!85!black}
}


%------------------------------------------------------------------------
% Exercise Style (purple)
%------------------------------------------------------------------------
\tcbset{
    matin-exercise/.style={matinbox=matinpurple!85!black}
}


%------------------------------------------------------------------------
% Remark Style (red)
%------------------------------------------------------------------------
\tcbset{
    matin-remark/.style={matinbox=matinred!80!black}
}


%========================================================================
% FAMILY 2 — OUTLINE-STYLE BOXES (matin-outline, RTL, breakable)
%========================================================================

%------------------------------------------------------------------------
% Base Outline Style
%------------------------------------------------------------------------
% The vertical rule is always on the east (visual right) side.
% No parity logic. No mirroring. This keeps the visual identity
% of the box identical on every page.
%------------------------------------------------------------------------
\tcbset{
    matin-outline/.style={
        enhanced,
        breakable,
        frame hidden,
        boxrule=0pt,
        colback=white,
        colframe=#1,
        coltitle=black,
        colbacktitle=white,
        fonttitle=\bfseries\normalsize,
        titlerule=0pt,
        left=10pt,
        right=14pt,
        top=8pt,
        bottom=8pt,
        toptitle=4pt,
        bottomtitle=4pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false,
        %--------------------------------------------------------------
        % Unbroken box: draw BOTH horizontal rules.
        %--------------------------------------------------------------
        underlay unbroken={%
            % Top rule — under the title
            \draw[#1, line width=2pt]
                ([yshift=0pt]title.south west) --
                ([yshift=0pt]title.south east);
            % Bottom rule — under the content
            \draw[#1, line width=2pt]
                ([yshift=0pt]frame.south west) --
                ([yshift=0pt]frame.south east);
        },
        %--------------------------------------------------------------
        % First fragment of a broken box: draw ONLY the top rule.
        %--------------------------------------------------------------
        underlay first={%
            \draw[#1, line width=2pt]
                ([yshift=0pt]title.south west) --
                ([yshift=0pt]title.south east);
        },
        %--------------------------------------------------------------
        % Last fragment of a broken box: draw ONLY the bottom rule.
        %--------------------------------------------------------------
        underlay last={%
            \draw[#1, line width=2pt]
                ([yshift=0pt]frame.south west) --
                ([yshift=0pt]frame.south east);
        },
        %--------------------------------------------------------------
        % Vertical rule on the east (right) side — 2pt, always present.
        %--------------------------------------------------------------
        borderline east={0pt}{0pt}{#1, line width=2pt}
    }
}


%------------------------------------------------------------------------
% Public outline styles (used by mb-theorem)
%------------------------------------------------------------------------
% These are the styles that mb-theorem references. Since there is
% no parity dispatch anymore, they can be plain `/.style` entries.
%------------------------------------------------------------------------
\tcbset{
    matin-example-outline/.style={matin-outline=matinorange!90!black},
    matin-proof-outline/.style={matin-outline=matindarkgray},
    matin-solution-outline/.style={matin-outline=matingreen!70!black}
}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-boxes}{Box styles loaded (2 families: matinbox, matin-outline RTL, breakable, 2pt rules, no parity mirroring)}

