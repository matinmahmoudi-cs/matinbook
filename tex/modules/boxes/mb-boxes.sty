%----------------------------------------
% mb-boxes.sty - TColorBox Styles for MatinBook
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mb-boxes}[2025/01/01 v1.0 MatinBook Box System]

%----------------------------------------
% Base Style - Minimal with Colored Title
%----------------------------------------
\tcbset{
    matinbox/.style={
        enhanced,
        breakable,
        colback=white,
        boxrule=0.8pt,
        arc=3pt,
        outer arc=3pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        toptitle=4pt,
        bottomtitle=4pt,
        fonttitle=\bfseries\small,
        coltitle=white,
        titlerule=0pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false
    }
}

%----------------------------------------
% Theorem Box
%----------------------------------------
\newtcolorbox{theorembox}[1]{
    matinbox,
    colframe=matinblue!80,
    colbacktitle=matinblue,
    title={\textbf{ } #1}
}

