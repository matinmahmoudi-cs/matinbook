%========================================================================
% MB-BOXES — TCOLORBOX STYLES
%========================================================================
%
% Purpose:
%   Provide tcolorbox STYLES for use with \tcolorboxenvironment.
%   This module does NOT define any environments — only styles.
%
% Usage (in mb-theorem.sty):
%   \tcolorboxenvironment{theorem}{matin-theorem}
%   \tcolorboxenvironment{lemma}{matin-lemma}
%   ...
%
% Color philosophy (Iranian educational publishing standards):
%   - Blue:   theorems, lemmas, definitions (calming)
%   - Orange: examples, remarks, exercises (attention)
%   - Green:  solutions, proofs (success)
%
%========================================================================


%------------------------------------------------------------------------
% Base Style
%------------------------------------------------------------------------
\tcbset{
    matinbox/.style={
        enhanced,
        breakable,
        colback=matincream,
        boxrule=0.8pt,
        arc=3pt,
        outer arc=3pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        toptitle=6pt,
        bottomtitle=4pt,
        fonttitle=\bfseries\normalsize,
        coltitle=white,
        titlerule=0pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false
    }
}


%------------------------------------------------------------------------
% Theorem Family Styles (blue)
%------------------------------------------------------------------------
\tcbset{
    matin-theorem/.style={
        matinbox,
        colframe=matinblue!80,
        colbacktitle=matinblue!90
    },
    matin-lemma/.style={
        matinbox,
        colframe=matinblue!70,
        colbacktitle=matinblue!80
    },
    matin-corollary/.style={
        matinbox,
        colframe=matinblue!60,
        colbacktitle=matinblue!70
    },
    matin-proposition/.style={
        matinbox,
        colframe=matinblue!75,
        colbacktitle=matinblue!85
    }
}


%------------------------------------------------------------------------
% Definition Style (lighter blue)
%------------------------------------------------------------------------
\tcbset{
    matin-definition/.style={
        matinbox,
        colframe=matinblue!50,
        colbacktitle=matinblue!60
    }
}


%------------------------------------------------------------------------
% Example Family Styles (orange)
%------------------------------------------------------------------------
\tcbset{
    matin-example/.style={
        matinbox,
        colframe=matinorange!80,
        colbacktitle=matinorange!90
    },
    matin-remark/.style={
        matinbox,
        colframe=matinorange!70,
        colbacktitle=matinorange!80
    },
    matin-exercise/.style={
        matinbox,
        colframe=matinorange!60,
        colbacktitle=matinorange!70
    }
}


%------------------------------------------------------------------------
% Solution / Proof Styles (green)
%------------------------------------------------------------------------
\tcbset{
    matin-solution/.style={
        matinbox,
        colframe=matingreen!70,
        colbacktitle=matingreen!80
    },
    matin-proof/.style={
        matinbox,
        colframe=matingreen!50,
        colbacktitle=matingreen!60
    }
}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-boxes}{Box styles loaded (3 colors: blue, orange, green)}

