%========================================================================
% MB-BOXES — TCOLORBOX STYLES
%========================================================================
%
% Purpose:
%   Provide tcolorbox STYLES for theorem-like environments.
%
% Two design families:
%   1. "matinbox"      — Boyer-style: solid colored title bar, white body
%   2. "matin-outline" — Outline style: right vertical line + horizontal rules
%
% Design family 1 (matinbox) — used by:
%   theorem, lemma, corollary, proposition, definition, remark, exercise
%
% Design family 2 (matin-outline) — used by:
%   example, proof, solution
%
% Title font size:
%   \normalsize (10pt) — same as body text, per AMS/Boyer standard.
%
% RTL note:
%   In matin-outline, the vertical line is drawn on the RIGHT side.
%
% Color note:
%   In matin-outline, the title text is BLACK (coltitle=black),
%   while the border lines keep the style color (#1).
%
% Breakable handling (tcolorbox 6.x):
%   The outline style uses underlay first/middle/last + overlay last
%   to draw the vertical line on the CORRECT side of each broken
%   piece:
%     - first piece: right vertical line + horizontal rule under title
%     - middle pieces: vertical line on the correct page side
%     - last piece: vertical line on the correct page side
%     - overlay last: horizontal rule at the bottom
%
%   This avoids the "line in the middle of the page" issue that
%   \`borderline east\` alone would cause on broken boxes.
%
%========================================================================


%========================================================================
% FAMILY 1 — BOYER-STYLE BOXES (matinbox)
%========================================================================

%------------------------------------------------------------------------
% Base Style
%------------------------------------------------------------------------
\tcbset{
    matinbox/.style={
        enhanced,
        breakable,
        sharp corners,
        boxrule=0.5pt,
        colback=white,
        colframe=#1,
        colbacktitle=#1,
        coltitle=white,
        fonttitle=\bfseries\normalsize,
        titlerule=0pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        toptitle=5pt,
        bottomtitle=5pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false
    }
}


%------------------------------------------------------------------------
% Theorem Family Styles (blue)
%------------------------------------------------------------------------
\tcbset{
    matin-theorem/.style={matinbox=matinblue},
    matin-lemma/.style={matinbox=matinblue!85!black},
    matin-corollary/.style={matinbox=matinblue!70!black},
    matin-proposition/.style={matinbox=matinblue!90!black}
}


%------------------------------------------------------------------------
% Definition Family Style (green)
%------------------------------------------------------------------------
\tcbset{
    matin-definition/.style={matinbox=matingreen!85!black}
}


%------------------------------------------------------------------------
% Exercise Style (purple)
%------------------------------------------------------------------------
\tcbset{
    matin-exercise/.style={matinbox=matinpurple!85!black}
}


%------------------------------------------------------------------------
% Remark Style (red)
%------------------------------------------------------------------------
\tcbset{
    matin-remark/.style={matinbox=matinred!80!black}
}


%========================================================================
% FAMILY 2 — OUTLINE-STYLE BOXES (matin-outline, RTL)
%========================================================================
%
% Design (RTL — vertical line on the RIGHT):
%
%   ──────────────────────────────────┤ EXAMPLE 1
%                                     │
%                                     │  content...
%                                     │
%   ──────────────────────────────────┘
%
% Features:
%   - Right vertical line (2pt, colored)
%   - Title WITHOUT background, BLACK bold text
%   - Horizontal rule under title (1pt, colored)
%   - Horizontal rule at bottom (1pt, colored)
%   - No frame on left/top/bottom sides
%   - White body
%
%------------------------------------------------------------------------

\tcbset{
    matin-outline/.style={
        enhanced,
        breakable,
        frame hidden,
        colback=white,
        coltitle=black,
        colbacktitle=white,
        fonttitle=\bfseries\normalsize,
        titlerule=0pt,
        left=10pt,
        right=12pt,
        top=8pt,
        bottom=8pt,
        toptitle=4pt,
        bottomtitle=4pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false,
        %---
        % First piece:
        %   - horizontal rule under title
        %   - right vertical line
        underlay first={%
            \draw[#1, line width=1pt]
                ([yshift=0pt]title.south west) -- ([yshift=0pt]title.south east);
            \draw[#1, line width=2pt]
                ([xshift=0pt]frame.north east) -- ([xshift=0pt]frame.south east);
        },
        %---
        % Middle pieces: vertical line on the correct page side
        underlay middle={%
            \ifodd\value{page}%
                \draw[#1, line width=2pt]
                    ([xshift=0pt]frame.north east) -- ([xshift=0pt]frame.south east);
            \else%
                \draw[#1, line width=2pt]
                    ([xshift=0pt]frame.north west) -- ([xshift=0pt]frame.south west);
            \fi
        },
        %---
        % Last piece: vertical line on the correct page side
        underlay last={%
            \ifodd\value{page}%
                \draw[#1, line width=2pt]
                    ([xshift=0pt]frame.north east) -- ([xshift=0pt]frame.south east);
            \else%
                \draw[#1, line width=2pt]
                    ([xshift=0pt]frame.north west) -- ([xshift=0pt]frame.south west);
            \fi
        },
        %---
        % Last piece: horizontal rule at bottom
        overlay last={%
            \draw[#1, line width=1pt]
                ([yshift=0pt]frame.south west) -- ([yshift=0pt]frame.south east);
        }
    }
}


%------------------------------------------------------------------------
% Outline Styles (for example, proof, solution)
%------------------------------------------------------------------------
\tcbset{
    matin-example-outline/.style={matin-outline=matinorange!90!black},
    matin-proof-outline/.style={matin-outline=matindarkgray},
    matin-solution-outline/.style={matin-outline=matingreen!70!black}
}


