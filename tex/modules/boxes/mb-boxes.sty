%========================================================================
% MB-BOXES — TCOLORBOX STYLES FOR THEOREM ENVIRONMENTS
%========================================================================
%
% Purpose:
%   Provide tcolorbox styles for the semantic environments defined
%   in mb-theorem.sty (theorem, lemma, definition, ...).
%
% Color philosophy (based on Iranian educational publishing standards):
%   - ONE dominant color: matinblue (calming, for theorems)
%   - ONE accent color:   matinorange (attention, for examples/remarks)
%   - ONE success color:  matingreen (for solutions/proofs)
%
%   Colors are used as TINTS (light/dark variants) rather than
%   different hues to maintain visual coherence.
%
%========================================================================


%------------------------------------------------------------------------
% Base Style
%------------------------------------------------------------------------
\tcbset{
    matinbox/.style={
        enhanced,
        breakable,
        colback=matincream,
        boxrule=0.8pt,
        arc=3pt,
        outer arc=3pt,
        left=10pt,
        right=10pt,
        top=8pt,
        bottom=8pt,
        toptitle=6pt,
        bottomtitle=4pt,
        fonttitle=\bfseries\normalsize,
        coltitle=white,
        titlerule=0pt,
        before skip=10pt,
        after skip=10pt,
        parbox=false
    }
}


%------------------------------------------------------------------------
% Theorem Family (blue — dominant color)
%------------------------------------------------------------------------
\newtcolorbox{theorembox}[1]{
    matinbox,
    colframe=matinblue!80,
    colbacktitle=matinblue!90,
    title={#1}
}

\newtcolorbox{lemmabox}[1]{
    matinbox,
    colframe=matinblue!70,
    colbacktitle=matinblue!80,
    title={#1}
}

\newtcolorbox{corollarybox}[1]{
    matinbox,
    colframe=matinblue!60,
    colbacktitle=matinblue!70,
    title={#1}
}

\newtcolorbox{propositionbox}[1]{
    matinbox,
    colframe=matinblue!75,
    colbacktitle=matinblue!85,
    title={#1}
}


%------------------------------------------------------------------------
% Definition (blue — lighter tint)
%------------------------------------------------------------------------
\newtcolorbox{definitionbox}[1]{
    matinbox,
    colframe=matinblue!50,
    colbacktitle=matinblue!60,
    title={#1}
}


%------------------------------------------------------------------------
% Example & Remark Family (orange — attention color)
%------------------------------------------------------------------------
\newtcolorbox{examplebox}[1]{
    matinbox,
    colframe=matinorange!80,
    colbacktitle=matinorange!90,
    title={#1}
}

\newtcolorbox{remarkbox}[1]{
    matinbox,
    colframe=matinorange!70,
    colbacktitle=matinorange!80,
    title={#1}
}


%------------------------------------------------------------------------
% Exercise (orange — attention color)
%------------------------------------------------------------------------
\newtcolorbox{exercisebox}[1]{
    matinbox,
    colframe=matinorange!60,
    colbacktitle=matinorange!70,
    title={#1}
}


%------------------------------------------------------------------------
% Solution & Proof (green — success color)
%------------------------------------------------------------------------
\newtcolorbox{solutionbox}{
    matinbox,
    colframe=matingreen!70,
    colbacktitle=matingreen!80,
    title={\textbf{\solutionname}}
}

\newtcolorbox{proofbox}{
    matinbox,
    colframe=matingreen!50,
    colbacktitle=matingreen!60,
    title={\textbf{\proofname}}
}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-boxes}{Box styles loaded (3 colors: blue, orange, green)}

\endinput
