\NeedsTeXFormat{LaTeX2e}[2023/06/01]
\ProvidesPackage{mb-references}[2026/10/08 v1.2 MatinBook References System]

%----------------------------------------
% Hyperref Setup
%----------------------------------------
\hypersetup{
    colorlinks=true,
    linkcolor=matinblue,
    citecolor=matinblue,
    urlcolor=matinblue,
    bookmarksopen=true,
    bookmarksnumbered=true,
    pdfcreator={MatinBook LaTeX Class},
    pdfproducer={XeLaTeX with MatinBook}
}

%----------------------------------------
% Reference Helpers
%----------------------------------------

% Quick reference to equation
\newcommand{\meqref}[1]{\cref{#1}}

% Quick reference to figure
\newcommand{\figref}[1]{\cref{#1}}

% Quick reference to table
\newcommand{\tabref}[1]{\cref{#1}}

% Quick reference to chapter
\newcommand{\chref}[1]{\cref{#1}}

% Quick reference to section
\newcommand{\secref}[1]{\cref{#1}}

%----------------------------------------
% URL and Hyperlink Helpers
%----------------------------------------

% Display URL in monospace font
\newcommand{\urlcode}[1]{\texttt{#1}}

% Email link
\newcommand{\email}[1]{\href{mailto:#1}{\texttt{#1}}}

%----------------------------------------
% Log
%----------------------------------------
\PackageInfo{mb-references}{References system loaded}

\endinput