%----------------------------------------
% mb-algorithm.sty - Algorithm Environments for MatinBook
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tex/modules/algorithm/mb-algorithm}[2025/01/01 v1.0 MatinBook Algorithm System]

%----------------------------------------
% Algorithm Numbering
%----------------------------------------
\numberwithin{algorithm}{chapter}

%----------------------------------------
% Algorithm Caption Command
% Works both inside and outside \begin{latin}
%----------------------------------------
\newcommand{\algcaption}[2][]{%
    \refstepcounter{algorithm}%
    \ifx\relax#1\relax\else
        \label{#1}%
    \fi
    % Add to List of Algorithms (with \rl for Persian)
    \addcontentsline{loa}{algorithm}{%
        \protect\numberline{\thealgorithm}%
        \rl{\algorithmname\space\thealgorithm: #2}%
    }%
    % Display caption
    \vspace{5pt}%
    \begin{center}%
        \small\textbf{\rl{\algorithmname\space\thealgorithm: #2}}%
    \end{center}%
    \vspace{10pt}%
}

%----------------------------------------
% Helper for Algorithm Reference
%----------------------------------------
\providecommand{\algref}[1]{\algorithmname\space\ref{#1}}

\endinput