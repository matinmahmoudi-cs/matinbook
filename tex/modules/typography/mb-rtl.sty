%----------------------------------------
% mb-rtl.sty - RTL/Bidi Support for MatinBook
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tex/modules/typography/mb-rtl}[2025/01/01 v1.0 MatinBook RTL Support]

%----------------------------------------
% Persian/Bidi Support
%----------------------------------------
% xepersian provides:
% - Right-to-left text direction
% - Persian numbering
% - Persian section names
% - Bidi algorithm
\RequirePackage{xepersian}

%----------------------------------------
% RTL-Specific Settings
%----------------------------------------
% These settings only make sense in RTL context

% Ensure proper rendering of Arabic script
\XeTeXlinebreaklocale "fa"
\XeTeXlinebreakskip = 0pt plus 1pt minus 1pt

%----------------------------------------
% Bidirectional Helpers
%----------------------------------------

% Inline Persian text in Latin context
\providecommand{\persian}{\rl}

%----------------------------------------
% Persian Date Support (Optional)
%----------------------------------------
% Helper for Persian dates
\newcommand{\persiandate}[3]{%
    #1/#2/#3 % year/month/day format
}

%----------------------------------------
% Log
%----------------------------------------
\typeout{MatinBook: RTL/Bidi support loaded (xepersian)}

\endinput