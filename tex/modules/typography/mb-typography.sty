\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mb-typography}[2026/01/01 v1.1 MatinBook Typography]

%========================================================================
% MB-TYPOGRAPHY — TYPOGRAPHY CONFIGURATION
%========================================================================
%
% Purpose:
%   Fine-tune typography settings for Persian technical books.
%
% Notes:
%   - Kashida (Persian letter stretching) is disabled by default
%     because it produces unnatural spacing in technical books.
%   - Persian text will use standard inter-word spacing.
%
%========================================================================


%------------------------------------------------------------------------
% Microtype Settings (XeTeX Compatible)
%------------------------------------------------------------------------
\microtypesetup{
    activate={true,nocompatibility},
    protrusion=true,
    expansion=false,
    final,
    verbose=silent
}

\SetProtrusion{encoding={TU,EU1,EU2}}{
    \textquotedblleft = {1000, },
    \textquotedblright = { ,1000},
    .  = { ,700},
    ,  = { ,700},
    :  = { ,500},
    ;  = { ,500}
}


%------------------------------------------------------------------------
% Kashida (Persian Letter Stretching) — DISABLED
%------------------------------------------------------------------------
% Kashida is disabled by default because it produces unnatural
% spacing in technical books. Users who want it can enable it
% by passing Kashida=on as a class option (future feature).
%
\IfFileExists{xepersian-hm.sty}{%
    \RequirePackage[%
        Kashida=off
    ]{xepersian-hm}%
}{%
    \PackageWarning{mb-typography}{%
        xepersian-hm not found.\MessageBreak
        Install it with: tlmgr install xepersian-hm%
    }%
}


%------------------------------------------------------------------------
% Line Breaking Settings
%------------------------------------------------------------------------
\emergencystretch=1em
\hbadness=3000
\tolerance=3000

\widowpenalty=10000
\clubpenalty=10000

\if@matin@draft
    \overfullrule=5pt
\else
    \overfullrule=0pt
\fi


%------------------------------------------------------------------------
% Hyphenation Settings
%------------------------------------------------------------------------
\hyphenpenalty=750
\exhyphenpenalty=750
\doublehyphendemerits=1000000
\finalhyphendemerits=0


%------------------------------------------------------------------------
% Custom Column Types for Tables
%------------------------------------------------------------------------
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-typography}{Typography settings loaded (Kashida disabled)}

\endinput
