\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mb-theme-default}[2026/01/01 v1.1 MatinBook Default Theme]

%========================================================================
% MB-THEME-DEFAULT — DEFAULT THEME LOADER
%========================================================================
%
% Purpose:
%   Load all components of the default theme.
%
% Components:
%   - mb-theme-colors: color palette
%   - mb-theme-cover:  cover design
%
% Note:
%   Fonts are configured directly in matinbook.cls AFTER xepersian
%   is loaded (per xepersian documentation: xepersian must be the
%   last package, and \settextfont must come after it).
%
%========================================================================

%------------------------------------------------------------------------
% Load theme components
%------------------------------------------------------------------------
\RequirePackage{mb-theme-colors}
\RequirePackage{mb-theme-cover}

%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-theme-default}{Default theme loaded}

\endinput
