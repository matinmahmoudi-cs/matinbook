%----------------------------------------
% cover.sty - Cover Style for MatinBook
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mb-theme-cover}[2025/01/01 v1.0 MatinBook Cover System]

%----------------------------------------
% Cover Colors
%----------------------------------------
\definecolor{coverbg}{RGB}{255, 255, 255}        % White
\definecolor{coverprimary}{RGB}{22, 33, 50}       % Dark navy
\definecolor{coveraccent}{RGB}{0, 185, 165}        % Teal (terminal green)
\definecolor{coveraccent2}{RGB}{255, 107, 85}     % Coral (warm)
\definecolor{coveraccent3}{RGB}{100, 140, 255}    % Blue (math)
\definecolor{covergray}{RGB}{100, 115, 130}        % Gray
\definecolor{coverlight}{RGB}{243, 246, 250}      % Light blue-gray
\definecolor{coverdark}{RGB}{15, 23, 38}           % Very dark

%----------------------------------------
% Decorative Elements
%----------------------------------------
\newcommand{\covergeometric}{
    \begin{tikzpicture}[remember picture,overlay]
        
        % Large circle top right
        \fill[coveraccent!6] 
        ([xshift=4cm,yshift=-4cm]current page.north east) circle (6cm);
        
        % Medium circle bottom left
        \fill[coveraccent3!5] 
        ([xshift=-3cm,yshift=3cm]current page.south west) circle (5cm);
        
        % Small coral circle
        \fill[coveraccent2!8] 
        ([xshift=-5cm,yshift=-8cm]current page.north east) circle (2cm);
        
        % Code brackets decoration (left side)
        \node[font=\ttfamily\fontsize{40}{48}\selectfont, color=coveraccent!10, anchor=west]
        at ([xshift=1cm,yshift=-10cm]current page.north west) {\{};
        
        \node[font=\ttfamily\fontsize{40}{48}\selectfont, color=coveraccent!10, anchor=west]
        at ([xshift=1cm,yshift=-22cm]current page.north west) {\}};
        
        % Lambda symbol faint
        \node[font=\fontsize{60}{72}\selectfont, color=coveraccent3!6]
        at ([xshift=-3cm,yshift=-15cm]current page.north east) {$\lambda$};
        
        % Sigma faint
        \node[font=\fontsize{50}{60}\selectfont, color=coveraccent3!5]
        at ([xshift=-8cm,yshift=-20cm]current page.north east) {$\Sigma$};
        
        % Dot grid pattern (graph paper feel)
        \foreach \x in {0.5,1.5,2.5,3.5} {
            \foreach \y in {1,2,3,4,5,6} {
                \fill[covergray!10] 
                ([xshift=\x cm,yshift=-\y cm]current page.north west) circle (0.5pt);
            }
        }
        
        % Binary numbers faint
        \node[font=\ttfamily\fontsize{7}{9}\selectfont, color=coveraccent!8, anchor=west]
        at ([xshift=0.3cm,yshift=-18cm]current page.north west) {01101000};
        
        % Math symbols
        \node[font=\fontsize{30}{36}\selectfont, color=coveraccent3!6]
        at ([xshift=-6cm,yshift=-8cm]current page.north east) {$\pi$};
        
        \node[font=\fontsize{25}{30}\selectfont, color=coveraccent3!5]
        at ([xshift=-2cm,yshift=-18cm]current page.north east) {$\infty$};
        
    \end{tikzpicture}
}

%----------------------------------------
% Front Cover
%----------------------------------------
\newcommand{\makecover}[4]{
    \begin{titlepage}
        \thispagestyle{empty}
        
        \covergeometric
        
        % Top bar with code-style decoration
        \noindent\begin{tikzpicture}
            \fill[coverprimary] (0,0) rectangle (\textwidth,0.5cm);
            % Three dots like window controls
            \fill[coveraccent2] (0.5,0.25) circle (3pt);
            \fill[coveraccent] (1.2,0.25) circle (3pt);
            \fill[coveraccent3] (1.9,0.25) circle (3pt);
            % Terminal prompt
            \node[font=\ttfamily\fontsize{8}{10}\selectfont, color=coveraccent, anchor=west]
            at (2.8,0.25) {\$ cd /book};
        \end{tikzpicture}
        
        \vspace{3cm}
        
        % Tag
        \begin{flushright}
            \colorbox{coveraccent!15}{
                \color{coverprimary}\fontsize{10}{14}\selectfont\bfseries
                \hspace{0.3cm} \covertag \hspace{0.3cm}
            }
        \end{flushright}
        
        \vspace{1cm}
        
        % Title
        \begin{flushright}
            \color{coverprimary}\fontsize{34}{44}\selectfont\bfseries
            #1
        \end{flushright}
        
        \vspace{0.8cm}
        
        % Subtitle
        \ifx\relax#2\relax\else
        \begin{flushright}
            \color{covergray}\fontsize{15}{22}\selectfont
            #2
        \end{flushright}
        \fi
        
        \vspace{2cm}
        
        % Decorative line with function notation
        \begin{flushleft}
            \begin{tikzpicture}
                \draw[coveraccent, line width=1.5pt] (0,0) -- (4,0);
                \fill[coveraccent] (4.5,0) circle (3pt);
                \node[font=\ttfamily\fontsize{8}{10}\selectfont, color=covergray!50, anchor=west]
                at (5,0) {main()};
            \end{tikzpicture}
        \end{flushleft}
        
        \vspace{2cm}
        
        % Author
        \begin{flushright}
            \colorbox{coverlight}{
                \begin{minipage}{0.5\textwidth}
                    \vspace{0.6cm}
                    \begin{flushright}
                        \color{coverprimary}\fontsize{14}{18}\selectfont\bfseries
                        #3 \\[0.3cm]
                        \color{coveraccent}\fontsize{10}{14}\selectfont
                        \texttt{//} #4
                    \end{flushright}
                    \vspace{0.6cm}
                \end{minipage}
            }
        \end{flushright}
        
        \vfill
        
        % Bottom bar
        \noindent\begin{tikzpicture}
            \fill[coverlight] (0,0) rectangle (\textwidth,1.8cm);
            \fill[coverprimary] (0,0) rectangle (\textwidth,0.06cm);
            
            % Left: Logo with code bracket
            \node[font=\ttfamily\fontsize{10}{12}\selectfont, color=coveraccent, anchor=west]
            at (0.3,1.3) {<};
            \node[font=\fontsize{10}{12}\selectfont, color=coverprimary!70, anchor=west]
            at (0.9,1.3) {MatinBook};
            \node[font=\ttfamily\fontsize{10}{12}\selectfont, color=coveraccent, anchor=west]
            at (3.7,1.3) {/>};
            
            % Center: GitHub
            \node[font=\ttfamily\fontsize{8}{10}\selectfont, color=covergray, anchor=center]
            at (\textwidth/2,1.3) {github.com/matinbook};
            
            % Right: Version with math
            \node[font=\fontsize{9}{11}\selectfont, color=covergray, anchor=east]
            at (\textwidth-0.5,1.3) {v1.0.0};
            
            % Decorative equation in footer
            \node[font=\fontsize{7}{9}\selectfont, color=covergray!30]
            at (\textwidth/2,0.6) {$f(x) = \displaystyle\sum_{n=0}^{\infty} a_n x^n$};
        \end{tikzpicture}
        
    \end{titlepage}
}

%----------------------------------------
% Back Cover
%----------------------------------------
\newcommand{\makebackcover}[1]{
    \clearpage
    \thispagestyle{empty}
    
    \covergeometric
    
    \vspace*{3cm}
    
    % Title with code style
    \begin{center}
        \color{coveraccent}\fontsize{18}{24}\selectfont\bfseries
        \texttt{/**} \coverabout \texttt{*/}
    \end{center}
    
    \vspace{0.5cm}
    
    \begin{center}
        \color{coveraccent}\rule{3cm}{1.5pt}
    \end{center}
    
    \vspace{1.5cm}
    
    % Content
    \begin{center}
        \colorbox{coverlight}{
            \begin{minipage}{0.75\textwidth}
                \vspace{1.2cm}
                \begin{flushright}
                    \color{coverprimary}\fontsize{12}{20}\selectfont
                    #1
                \end{flushright}
                \vspace{1.2cm}
            \end{minipage}
        }
    \end{center}
    
    \vspace{2cm}
    
    % QR / Link box
    \begin{center}
        \colorbox{coverprimary}{
            \begin{minipage}{5cm}
                \vspace{0.5cm}
                \begin{center}
                    \color{white}\fontsize{9}{12}\selectfont
                    \textbf{\coversource}\\[0.3cm]
                    \color{coveraccent}\ttfamily\fontsize{8}{10}\selectfont
                    github.com/matinbook
                \end{center}
                \vspace{0.5cm}
            \end{minipage}
        }
    \end{center}
    
    \vspace{1cm}
    
    % Code snippet decoration
    \begin{center}
        \color{covergray!30}\ttfamily\fontsize{7}{9}\selectfont
        print("Made with MatinBook")
    \end{center}
    
    \vfill
    
    % Bottom
    \noindent\begin{tikzpicture}
        \fill[coverprimary] (0,0) rectangle (\textwidth,0.5cm);
        \fill[coveraccent] (0,0) rectangle (3,0.5cm);
        \node[font=\ttfamily\fontsize{8}{10}\selectfont, color=white, anchor=west]
        at (0.3,0.25) {\$ exit};
    \end{tikzpicture}
}

\endinput