%========================================================================
% FRONT COVER
%========================================================================
\newcommand{\mb@frontart}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[coverprimary] (current page.north west) rectangle (current page.south east);
    \fill[coveraccent]
      (current page.north west) --
      ([xshift=10.2cm]current page.north west) --
      ([xshift=6.4cm,yshift=-3.15cm]current page.north west) -- cycle;
    \draw[white,opacity=.78,line width=.55pt]
      ([xshift=.58cm,yshift=-.58cm]current page.north west) rectangle
      ([xshift=-.58cm,yshift=.58cm]current page.south east);
    \foreach \x in {1,...,20}{%
      \draw[white,opacity=.045,line width=.25pt]
        ([xshift=\x cm]current page.north west) --
        ([xshift=\x cm]current page.south west);}
    \foreach \y in {1,...,28}{%
      \draw[white,opacity=.045,line width=.25pt]
        ([yshift=-\y cm]current page.north west) --
        ([yshift=-\y cm]current page.north east);}
    \begin{scope}[shift={([xshift=-5.5cm,yshift=-11.5cm]current page.north east)},rotate=-18]
      \draw[covergold,opacity=.34,line width=.9pt]
        (0,0) ellipse [x radius=4.25cm,y radius=2.25cm];
    \end{scope}
    \begin{scope}[shift={([xshift=11.2cm,yshift=-12.2cm]current page.north west)}]
      \draw[covergold,opacity=.78,line width=1.05pt,smooth,domain=0:6,samples=100,variable=\x]
        plot (\x,{1.25+0.78*exp(-0.3*\x)*sin(deg(2*\x))});
      \draw[white,opacity=.42,line width=.75pt,smooth,domain=.15:5.7,samples=80,variable=\x]
        plot (\x,{-.15+0.44*ln(\x+1)});
      \draw[coveraccent,opacity=.8,line width=.7pt,-{Stealth[length=1.8mm]}]
        (4.35,1.15) -- (4.95,1.36);
      \draw[coveraccent,opacity=.8,line width=.7pt,-{Stealth[length=1.8mm]}]
        (2.65,.47) -- (3.2,.27);
    \end{scope}
    \node[anchor=north west,draw=covergold,draw opacity=.48,fill=white,fill opacity=.075,
      rounded corners=2pt,line width=.65pt,inner sep=7pt,text=white!88,
      text opacity=.92,align=left,font=\ttfamily\scriptsize]
      at ([xshift=1.25cm,yshift=-14.65cm]current page.north west)
      {\shortstack[l]{%
        {\color{covergold}\texttt{// numerical methods}}\\[-1pt]
        \texttt{template\textless typename T\textgreater}\\[-1pt]
        \texttt{constexpr auto solve\_ode =}\\[-1pt]
        \texttt{  [](auto f, auto y) \{}\\[-1pt]
        \texttt{    auto [u, v] = y;}\\[-1pt]
        \texttt{    return f(u, v);}}\\[-1pt]
        \texttt{  \};}};
    \node[anchor=north west,text=white!84,align=left,font=\small]
      at ([xshift=1.35cm,yshift=-19.1cm]current page.north west)
      {$\displaystyle e^{i\pi}+1=0\qquad
        \mathcal{F}\{f\}(\omega)=\int_{-\infty}^{\infty}f(t)e^{-i\omega t}\,dt$};
    \node[anchor=north west,text=covergold!90,align=left,font=\small]
      at ([xshift=1.35cm,yshift=-20.0cm]current page.north west)
      {$\displaystyle \frac{d}{dt}\frac{\partial L}{\partial\dot q}
        -\frac{\partial L}{\partial q}=0\qquad
        y_{n+1}=y_n+h\sum_i b_i k_i$};
    \draw[coveraccent,line width=.8pt,-{Stealth[length=2mm]}]
      ([xshift=-1.35cm,yshift=-7.1cm]current page.north east) --
      ([xshift=-4.0cm,yshift=-7.1cm]current page.north east);
    \draw[coveraccent,line width=.8pt,-{Stealth[length=2mm]}]
      ([xshift=-2.0cm,yshift=-8.15cm]current page.north east) --
      ([xshift=-2.0cm,yshift=-5.9cm]current page.north east);
    \fill[coveraccent] ([xshift=-4.0cm,yshift=-7.1cm]current page.north east) circle (1.25pt);
    \fill[coveraccent] ([xshift=-2.0cm,yshift=-8.15cm]current page.north east) circle (1.25pt);
    \draw[covergold,line width=1.15pt]
      ([xshift=-1.15cm,yshift=1.15cm]current page.south east) --
      ([xshift=-.58cm,yshift=1.15cm]current page.south east) --
      ([xshift=-.58cm,yshift=1.72cm]current page.south east);
  \end{tikzpicture}%
}

\newcommand{\makecover}[4]{%
  \begin{titlepage}\thispagestyle{empty}
    \mb@frontart
    \vspace*{1.75cm}
    \begin{flushright}
      {\color{covergold}\fontsize{10}{14}\selectfont\bfseries
        MATHEMATICS / COMPUTER SCIENCE\par}
      \vspace{1.25cm}
      {\color{white}\fontsize{34}{43}\selectfont\bfseries #1\par}
      \vspace{.42cm}
      \hfill{\color{covergold}\rule{3.6cm}{1.35pt}}\par
      \vspace{.52cm}
      \if\relax\detokenize{#2}\relax\else
        {\color{white}\fontsize{17}{24}\selectfont #2\par}
      \fi
    \end{flushright}
    \vfill
    \begin{flushright}
      {\color{white}\fontsize{16}{21}\selectfont\bfseries #3\par}
      \vspace{.22cm}
      {\color{covergold}\fontsize{11}{15}\selectfont\bfseries ویرایش\enspace #4\par}
    \end{flushright}
    \vspace{1.0cm}
    \noindent{\color{white}\fontsize{9}{12}\selectfont\bfseries MatinBook}%
    \hfill{\color{white}\fontsize{9}{12}\selectfont\ttfamily\repository}\par
    \vspace*{.2cm}
  \end{titlepage}%
}


%========================================================================
% BACK COVER — STATIC, TWO-BLOCK LAYOUT (RTL)
%========================================================================
% Ivory background + thin crimson rule at the top. No decorative
% mathematical elements. Two static blocks separated by 0.7cm.
% All content lives inside a fixed-height minipage to prevent
% overflow onto a second page.
%
% The whole body is wrapped in \beginR...\endR so that the minipage
% contents are laid out right-to-left, as required for Persian.
%------------------------------------------------------------------------
\newcommand{\mb@backart}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[coverpaper] (current page.north west) rectangle (current page.south east);
    \draw[coveraccent,line width=.85pt]
      ([xshift=.65cm,yshift=-.62cm]current page.north west) --
      ([xshift=-.65cm,yshift=-.62cm]current page.north east);
  \end{tikzpicture}%
}

\newcommand{\makebackcover}[1]{%
  \clearpage
  \thispagestyle{empty}%
  \mb@backart
  \vspace*{6.5cm}%
  \noindent
  \beginR
  \begin{minipage}[t][\dimexpr\paperheight-8.9cm\relax][s]{\textwidth}
    %--------------------------------------------------------------
    % Block 1 — About this book (primary, larger)
    %--------------------------------------------------------------
    \begin{flushright}
      {\color{coverprimary}\fontsize{20}{26}\selectfont\bfseries\coverabout\par}
      \vspace{.28cm}
      \noindent{\color{coveraccent}\rule{\linewidth}{.8pt}}\par
    \end{flushright}
    \vspace{.42cm}
    \begin{flushright}
      \begin{minipage}{.92\textwidth}
        \raggedright\color{coverprimary}\fontsize{12}{20}\selectfont #1\par
      \end{minipage}
    \end{flushright}
    %--------------------------------------------------------------
    % Gap between the two blocks — 0.7cm
    %--------------------------------------------------------------
    \vspace{0.7cm plus 0.2cm minus 0.2cm}
    %--------------------------------------------------------------
    % Block 2 — About the author (secondary, smaller)
    %--------------------------------------------------------------
    \ifx\matin@authorbio\empty\else
      \begin{flushright}
        {\color{coverprimary}\fontsize{15}{20}\selectfont\bfseries\coverauthorbio\par}
        \vspace{.22cm}
        \noindent{\color{coveraccent}\rule{\linewidth}{.6pt}}\par
      \end{flushright}
      \vspace{.35cm}
      \begin{flushright}
        \begin{minipage}{.92\textwidth}
          \raggedright\color{coverprimary}\fontsize{10}{16}\selectfont\matin@authorbio\par
        \end{minipage}
      \end{flushright}
    \fi
    %--------------------------------------------------------------
    % Footer — pushed to the bottom of the fixed-height minipage
    %--------------------------------------------------------------
    \vfill
    \begin{flushright}
      {\color{coverprimary}\fontsize{11}{15}\selectfont\bfseries MatinBook\par}
      \vspace{.12cm}
      {\color{coverprimary}\fontsize{9}{12}\selectfont\ttfamily\repository\par}
      \vspace{.1cm}
      {\color{covergold}\fontsize{10}{14}\selectfont\bfseries\coversource\par}
    \end{flushright}
  \end{minipage}%
  \endR
  \clearpage
}


