%----------------------------------------
% fonts.sty - Default Theme Fonts
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mb-theme-fonts}[2025/01/01 v1.0 MatinBook Default Fonts]

%----------------------------------------
% Default Font Features
%----------------------------------------
\defaultfontfeatures{
    Mapping=tex-text
}

%----------------------------------------
% Persian Font Setup
%----------------------------------------
% Set Persian font based on class option
\if@matin@vazirmatn
\settextfont[Script=Arabic,Scale=1.2]{Vazirmatn}
\else
\if@matin@sahel
\settextfont[Script=Arabic,Scale=1.2]{Sahel}
\else
\if@matin@irlotus
\settextfont[Script=Arabic,Scale=1.2]{IR Lotus}
\else
% Default: XB Niloofar
\settextfont[Script=Arabic,Scale=1.2]{XB Niloofar}
\fi
\fi
\fi

%----------------------------------------
% Latin Font Setup
%----------------------------------------
% Times New Roman for Latin text (without Ligatures to avoid warnings)
\setlatintextfont{Times New Roman}

%----------------------------------------
% Math Font Setup
%----------------------------------------
% Try XITS Math first, fallback to Latin Modern Math if not available
\IfFontExistsTF{XITS Math}{%
    \setmathfont{XITS Math}
}{%
    \IfFontExistsTF{XITSMath-Regular.otf}{%
        \setmathfont{XITSMath-Regular.otf}
    }{%
        \IfFontExistsTF{Latin Modern Math}{%
            \setmathfont{Latin Modern Math}
            \typeout{Warning: XITS Math not found! Using Latin Modern Math.}
        }{%
            \typeout{Warning: No math font found! Using default math font.}
        }%
    }%
}

%----------------------------------------
% Code Font Setup
%----------------------------------------
% JetBrains Mono for code listings
\IfFontExistsTF{JetBrains Mono}{%
    \newfontfamily\codefont{JetBrains Mono}[
    Scale=0.9,
    Ligatures=TeX
    ]
}{%
    \IfFontExistsTF{JetBrainsMono-Regular.ttf}{%
        \newfontfamily\codefont{JetBrainsMono-Regular.ttf}[
        Scale=0.9,
        Ligatures=TeX
        ]
    }{%
        % Fallback to default monospace
        \newfontfamily\codefont{Courier New}[Scale=0.9]
        \typeout{Warning: JetBrains Mono not found! Using Courier New.}
    }%
}

%----------------------------------------
% Log
%----------------------------------------
\typeout{MatinBook: Default theme fonts loaded (\matin@fontname)}

\endinput