\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mb-theme-fonts}[2026/01/01 v1.1 MatinBook Default Fonts]

%========================================================================
% MB-THEME-FONTS — DEFAULT THEME FONT CONFIGURATION
%========================================================================
%
% Default Persian font: XB Niloofar (free, complete, LaTeX-optimized)
% Alternative: B Nazanin (commercial, incomplete glyphs — not recommended)
%
%========================================================================

\defaultfontfeatures{Mapping=tex-text}

%------------------------------------------------------------------------
% Persian Font Setup (dispatched via \matin@fontname)
%------------------------------------------------------------------------
\ifdefstring{\matin@fontname}{XBNiloofar}{%
    \settextfont[Script=Arabic,Scale=1.2]{XB Niloofar}%
}{%
\ifdefstring{\matin@fontname}{Vazirmatn}{%
    \settextfont[Script=Arabic,Scale=1.2]{Vazirmatn}%
}{%
\ifdefstring{\matin@fontname}{Sahel}{%
    \settextfont[Script=Arabic,Scale=1.2]{Sahel}%
}{%
\ifdefstring{\matin@fontname}{IRLotus}{%
    \settextfont[Script=Arabic,Scale=1.2]{IR Lotus}%
}{%
\ifdefstring{\matin@fontname}{BNazanin}{%
    \settextfont[Script=Arabic,Scale=1.0]{B Nazanin}%
}{%
    % Fallback: use XB Niloofar if unknown
    \PackageWarning{mb-theme-fonts}{Unknown font '\matin@fontname'.\MessageBreak
        Using XB Niloofar as fallback}%
    \settextfont[Script=Arabic,Scale=1.2]{XB Niloofar}%
}}}}}

%------------------------------------------------------------------------
% Latin Font Setup
%------------------------------------------------------------------------
\IfFontExistsTF{Times New Roman}{%
    \setlatintextfont{Times New Roman}%
}{%
    \setlatintextfont{TeX Gyre Termes}%
    \PackageWarning{mb-theme-fonts}{Times New Roman not found. Using TeX Gyre Termes}%
}

%------------------------------------------------------------------------
% Math Font Setup
%------------------------------------------------------------------------
\IfFontExistsTF{XITS Math}{%
    \setmathfont{XITS Math}%
}{%
    \IfFontExistsTF{XITSMath-Regular.otf}{%
        \setmathfont{XITSMath-Regular.otf}%
    }{%
        \IfFontExistsTF{Latin Modern Math}{%
            \setmathfont{Latin Modern Math}%
            \PackageWarning{mb-theme-fonts}{XITS Math not found. Using Latin Modern Math}%
        }{%
            \PackageWarning{mb-theme-fonts}{No math font found}%
        }%
    }%
}

%------------------------------------------------------------------------
% Monospace Font Setup (for \texttt)
%------------------------------------------------------------------------
\IfFontExistsTF{DejaVu Sans Mono}{%
    \setmonofont{DejaVu Sans Mono}[Scale=0.9]%
}{%
    \IfFontExistsTF{Courier New}{%
        \setmonofont{Courier New}[Scale=0.9]%
    }{%
        \PackageWarning{mb-theme-fonts}{No monospace font found}%
    }%
}

%------------------------------------------------------------------------
% Code Font (for minted)
%------------------------------------------------------------------------
\IfFontExistsTF{JetBrains Mono}{%
    \newfontfamily\codefont{JetBrains Mono}[
        Scale=0.9,
        Ligatures=TeX
    ]%
}{%
    \IfFontExistsTF{DejaVu Sans Mono}{%
        \newfontfamily\codefont{DejaVu Sans Mono}[
            Scale=0.9,
            Ligatures=TeX
        ]%
    }{%
        \newfontfamily\codefont{Courier New}[Scale=0.9]%
        \PackageWarning{mb-theme-fonts}{JetBrains Mono not found. Using Courier New}%
    }%
}

%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{mb-theme-fonts}{Default theme fonts loaded (Persian: \matin@fontname)}

\endinput
