%----------------------------------------
% mb-engine.sty - Engine Detection for MatinBook
% Version: 1.0
%----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mb-engine}[2025/01/01 v1.0 MatinBook Engine Detection]

%----------------------------------------
% Engine Requirements
%----------------------------------------
\RequirePackage{iftex}

% Check for pdfTeX first (meaningful error)
\ifpdftex
\PackageError{mb-engine}{%
    MatinBook requires XeLaTeX to compile!\MessageBreak
    Please use: xelatex -shell-escape yourfile.tex
}{%
    MatinBook uses xepersian which only works with XeLaTeX.\MessageBreak
    Switch to XeLaTeX and try again.%
}
\fi

% Check for LuaLaTeX (warning)
\ifluatex
\PackageWarning{mb-engine}{%
    LuaLaTeX support is experimental.\MessageBreak
    For best results, use XeLaTeX.%
}
\fi

% Ensure XeTeX
\RequireXeTeX

%----------------------------------------
% Engine Info Message
%----------------------------------------
\typeout{========================================}
\typeout{MatinBook - Professional Persian Book Class}
\typeout{Engine: XeLaTeX}
\typeout{Version: 1.0}
\typeout{========================================}

\endinput