%------------------------------------------------------------------------
% Latin Title / Author
%------------------------------------------------------------------------
\providecommand{\@latintitle}{}
\providecommand{\@latinauthor}{}

\newcommand{\latintitle}[1]{\gdef\@latintitle{#1}}
\newcommand{\latinauthor}[1]{\gdef\@latinauthor{#1}}


%------------------------------------------------------------------------
% Helper: Safe Command Check
%------------------------------------------------------------------------
% Returns #2 if command #1 is defined, #3 otherwise.
% Usage: \matin@ifcmd{somecommand}{true code}{false code}
%------------------------------------------------------------------------
\newcommand{\matin@ifcmd}[3]{%
    \ifcsname #1\endcsname
        \expandafter\@firstoftwo
    \else
        \expandafter\@secondoftwo
    \fi
    {#2}{#3}%
}

\makeatother


