\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{en-US}[2026/01/01 v1.1 MatinBook English Locale]

%========================================================================
% EN-US — ENGLISH (US) LOCALE
%========================================================================
%
% Purpose:
%   Localize LaTeX names and cleveref references to English.
%
% Note:
%   This file mirrors fa-IR.sty for symmetry.
%   It is loaded AFTER xepersian in matinbook.cls.
%
%========================================================================


%------------------------------------------------------------------------
% Document Structure Names
%------------------------------------------------------------------------
\renewcommand{\contentsname}{Contents}
\renewcommand{\listfigurename}{List of Figures}
\renewcommand{\listtablename}{List of Tables}
\renewcommand{\bibname}{Bibliography}
\renewcommand{\indexname}{Index}
\renewcommand{\chaptername}{Chapter}
\renewcommand{\appendixname}{Appendix}
\renewcommand{\proofname}{Proof}
\providecommand{\abstractname}{Abstract}
\renewcommand{\partname}{Part}
\providecommand{\refname}{References}


%------------------------------------------------------------------------
% Float Names
%------------------------------------------------------------------------
\renewcommand{\figurename}{Figure}
\renewcommand{\tablename}{Table}


%------------------------------------------------------------------------
% Algorithm Names
%------------------------------------------------------------------------
% NOTE: xepersian's algorithm-xepersian.def already defines
% \ALG@name and \listalgorithmname. We only override if needed.
\providecommand{\listalgorithmname}{List of Algorithms}


%------------------------------------------------------------------------
% Index Names
%------------------------------------------------------------------------
\renewcommand{\seename}{see}
\renewcommand{\alsoname}{see also}


%------------------------------------------------------------------------
% Cleveref Translations
%------------------------------------------------------------------------
% Must be loaded AFTER cleveref. Since cleveref is in mb-core
% (before xepersian) and this file is loaded after xepersian,
% the order is correct.
%------------------------------------------------------------------------
\crefname{equation}{Equation}{Equations}
\crefname{chapter}{Chapter}{Chapters}
\crefname{section}{Section}{Sections}
\crefname{subsection}{Subsection}{Subsections}
\crefname{figure}{Figure}{Figures}
\crefname{table}{Table}{Tables}
\crefname{algorithm}{Algorithm}{Algorithms}
\crefname{theorem}{Theorem}{Theorems}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{corollary}{Corollary}{Corollaries}
\crefname{definition}{Definition}{Definitions}
\crefname{example}{Example}{Examples}
\crefname{remark}{Remark}{Remarks}
\crefname{exercise}{Exercise}{Exercises}
\crefname{proposition}{Proposition}{Propositions}

% Range formats
\crefrangeformat{equation}{Equations~#3#1#4~to~#5#2#6}
\crefrangeformat{figure}{Figures~#3#1#4~to~#5#2#6}
\crefrangeformat{table}{Tables~#3#1#4~to~#5#2#6}
\crefrangeformat{theorem}{Theorems~#3#1#4~to~#5#2#6}

% Conjunctions — must be set AFTER cleveref is loaded.
% Use \AtBeginDocument to ensure cleveref is loaded first.
\AtBeginDocument{%
    \renewcommand{\crefpairconjunction}{\,and\,}%
    \renewcommand{\crefrangeconjunction}{\,to\,}%
    \renewcommand{\crefmiddleconjunction}{\,,\,}%
    \renewcommand{\creflastconjunction}{\,and\,}%
}


%------------------------------------------------------------------------
% Section Headings (fallbacks)
%------------------------------------------------------------------------
\providecommand{\sectionname}{Section}
\providecommand{\pagename}{Page}


%------------------------------------------------------------------------
% Theorem Names (used by mb-theorem)
%------------------------------------------------------------------------
\providecommand{\theoremname}{Theorem}
\providecommand{\lemmaname}{Lemma}
\providecommand{\corollaryname}{Corollary}
\providecommand{\propositionname}{Proposition}
\providecommand{\definitionname}{Definition}
\providecommand{\examplename}{Example}
\providecommand{\remarkname}{Remark}
\providecommand{\exercisename}{Exercise}
\providecommand{\solutionname}{Solution}


%------------------------------------------------------------------------
% Code & Algorithm Names
%------------------------------------------------------------------------
\providecommand{\codename}{Code}
\providecommand{\algorithmname}{Algorithm}


%------------------------------------------------------------------------
% Cover Names (used by mb-theme-cover)
%------------------------------------------------------------------------
\providecommand{\coverpublisher}{Publisher}
\providecommand{\coveredition}{Edition}
\providecommand{\coverisbn}{ISBN}
\providecommand{\covertag}{Programming and Mathematics}
\providecommand{\coverabout}{About This Book}
\providecommand{\coversource}{View Source Code}


%------------------------------------------------------------------------
% Log
%------------------------------------------------------------------------
\PackageInfo{en-US}{English locale loaded}

\endinput
