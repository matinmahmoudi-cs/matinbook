*.py[cod]
*$py.class
.venv/
venv/
env/

# ============================================
# Node (if any JS tooling later)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Misc
# ============================================
*.bak
*.tmp
*.temp
.cache/
